{
  "name": "agent-wallet-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Guarded stablecoin wallet for AI agents on Circle Arc, with a built-in red-team suite and safety score.",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "dashboard": "tsx src/cli.ts dashboard",
    "redteam": "tsx src/cli.ts run --all --compare",
    "redteam:api": "tsx src/cli.ts run --suite api --compare",
    "setup-wallets": "tsx src/cli.ts gateway status",
    "gateway:deposit": "tsx src/cli.ts gateway deposit",
    "demo:replay": "tsx src/cli.ts dashboard --replay",
    "no-guard": "tsx src/cli.ts no-guard",
    "compare": "tsx src/cli.ts compare",
    "buy": "tsx src/cli.ts buy",
    "refund": "tsx src/cli.ts refund",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutate": "vitest run test/redteam/mutation.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@circle-fin/x402-batching": "4.0.0",
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "dotenv": "^16.4.5",
    "openai": "^4.77.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "solc": "^0.8.38",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
