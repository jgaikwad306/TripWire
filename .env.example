# Copy to .env and fill in. Never commit .env.

# Circle Developer-Controlled Wallets (console.circle.com) — lane A
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Filled in by `npm run cli setup`
CIRCLE_WALLET_SET_ID=
WALLET_ID_VAULT=
WALLET_ID_HOT=
WALLET_ID_MERCHANT=
# Throwaway testnet key for the attacker (also printed by `setup`). Not a guarded wallet.
ATTACKER_PRIVATE_KEY=
# Filled in by `npm run cli fake-usdc`
FAKE_USDC_ADDRESS=

# Arc Testnet. rpc.testnet.arc.network also works.
ARC_RPC_URL=https://rpc.testnet.arc.io

# xAI / Grok — lane C. Set XAI_MODEL to a current tool-calling model from the xAI docs.
XAI_API_KEY=
XAI_MODEL=

# Mock merchant server — lane C
MERCHANT_PORT=4020
