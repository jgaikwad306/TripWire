# Copy to .env and fill in. Never commit .env.

# Circle Developer-Controlled Wallets (console.circle.com) — lane A
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Filled in by `npm run cli setup`
CIRCLE_WALLET_SET_ID=
WALLET_ID_VAULT=
WALLET_ID_HOT=
WALLET_ID_MERCHANT=
# Throwaway testnet key for the attacker (also printed by `setup`). Not a guarded wallet.
ATTACKER_PRIVATE_KEY=
# Filled in by `npm run cli fake-usdc`
FAKE_USDC_ADDRESS=

# Who settles x402 payments on Arc: circle (default; Circle's Facilitator Service, keyless
# trial, falls back to local when it runs out) or local (run here; the merchant wallet pays gas).
X402_FACILITATOR=circle

# Arc Testnet. rpc.testnet.arc.network also works.
ARC_RPC_URL=https://rpc.testnet.arc.io

# Circle Gateway nanopayments (the paid API). The testnet API needs no key.
# The agent pays from the hot wallet's Gateway balance: `npm run gateway:deposit -- 2`.
# The seller (payee) is the merchant wallet and the attacker is ATTACKER_PRIVATE_KEY's
# address; `npm run setup-wallets` prints both.
GATEWAY_API_URL=https://gateway-api-testnet.circle.com

# on | off. off = the unguarded baseline that signs whatever a 402 asks (testnet only:
# it refuses to run unless the RPC is Arc Testnet and NETWORK, if set, is a testnet).
GUARD_MODE=on
NETWORK=testnet

# xAI / Grok — lane C. Set XAI_MODEL to a current tool-calling model from the xAI docs.
XAI_API_KEY=
XAI_MODEL=

# Gemini Prediction Markets. simulated | sandbox | production. Unguarded runs are always simulated.
GEMINI_ENV=simulated
# Optional override for where live runs read events. Leave unset: they read the environment
# GEMINI_ENV trades on (the sandbox lists far fewer events than production).
# GEMINI_MARKET_DATA_URL=https://api.gemini.com
# Trader role only. No transfer or withdraw permissions. Never commit.
GEMINI_API_KEY=
GEMINI_API_SECRET=
# Only for master keys
GEMINI_ACCOUNT=
# time (Gemini's recommended key setting) | increment
GEMINI_NONCE_MODE=time
# Required to place real orders in production (guarded pass only)
GEMINI_ALLOW_PRODUCTION=0
# Optional: the event the market task trades. Default: picked from live data.
GEMINI_DEMO_EVENT=

# Mock merchant server — lane C
MERCHANT_PORT=4020

# QuickNode Streams: start `streams serve`, expose its webhook with an HTTPS tunnel,
# then run `streams setup`. API key needs Streams read/write access; never commit it.
QUICKNODE_API_KEY=
# Opt-in safety checks for guarded Arc runs. Stale/disconnected monitoring blocks spending.
QUICKNODE_STREAMS_ENABLED=false
QUICKNODE_STREAMS_DATA_DIR=.data/streams
# Local authenticated control API; never expose this port through the tunnel.
QUICKNODE_STREAMS_CONTROL_URL=http://127.0.0.1:4022
